{
    "name": "sonole/laravel-gov-gr",
    "description": "Laravel client for Greek government/business APIs (GEMI, AMKA, ERGANI, tax registry, bank confirm) and TAXISnet/gov.gr OAuth2 login, in one package.",
    "keywords": [
        "laravel",
        "greece",
        "greek",
        "gov.gr",
        "taxisnet",
        "gsis",
        "aade",
        "gemi",
        "amka",
        "ergani",
        "tax-registry",
        "afm",
        "oauth2",
        "sso",
        "api-client",
        "government-api",
        "business-registry"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alexandros Paliampelos",
            "email": "f5890620@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-simplexml": "*",
        "ext-libxml": "*",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "phpstan/phpstan": "^2.2"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "phpstan": "vendor/bin/phpstan analyse -l 8 src --memory-limit=1G"
    },
    "autoload": {
        "psr-4": {
            "Sonole\\GovGr\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sonole\\GovGr\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["Sonole\\GovGr\\GovGrServiceProvider"],
            "aliases": {
                "Amka": "Sonole\\GovGr\\Amka\\Facades\\Amka",
                "BankConfirm": "Sonole\\GovGr\\BankConfirm\\Facades\\BankConfirm",
                "Ergani": "Sonole\\GovGr\\Ergani\\Facades\\Ergani",
                "Gemi": "Sonole\\GovGr\\Gemi\\Facades\\Gemi",
                "TaxisnetOAuth": "Sonole\\GovGr\\TaxisnetOAuth\\Facades\\TaxisnetOAuth",
                "TaxRegistry": "Sonole\\GovGr\\TaxRegistry\\Facades\\TaxRegistry"
            }
        }
    }
}
